---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const prescriptions = await getCollection('prescriptions');
  // 按 publishedAt 倒序：既用于上一篇/下一篇，也用于相关推荐的兜底
  const sorted = [...prescriptions].sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );

  return sorted.map((entry, i) => {
    // 相关处方：同类目优先（主题集群内链），不足则用最新的补齐。
    // 注：排序仍按 category（更细粒度，主题集群内链质量更高），
    // 但卡片与面包屑「显示」给用户的一律用 role（岗位桶），与首页/列表页口径一致。
    const sameCategory = sorted.filter(
      (p) => p.id !== entry.id && p.data.category === entry.data.category,
    );
    const rest = sorted.filter(
      (p) => p.id !== entry.id && p.data.category !== entry.data.category,
    );
    const related = [...sameCategory, ...rest].slice(0, 3);

    return {
      params: { id: entry.id },
      props: {
        entry,
        prev: sorted[i - 1] ?? null,
        next: sorted[i + 1] ?? null,
        related,
      },
    };
  });
}

const { entry, prev, next, related } = Astro.props;
const { Content } = await render(entry);

const dateStr = (d: Date) => d.toISOString().slice(0, 10);

// FAQ：文章可在 frontmatter 里写 faqs（数组），写了才输出 FAQPage schema。
// 没有真实 Q&A 就不要硬造——PAA 富摘要要靠真问题，不是模板。
const faqs = entry.data.faqs ?? [];

/**
 * 步骤概览（2026-09-08 加·纯 CSS 视觉直观）
 * 从正文「一步步怎么配」章节自动提取有序列表的步骤标题，渲染成步骤条。
 * 好处：16 篇立即生效、零内容改动、零维护成本；且步骤来自正文真实内容，不是编造的。
 * 桌面 Agent 是「操作软件」，读者最需要「看清一共几步、每步干什么」——此前全靠文字想象。
 */
function extractSteps(body: string) {
  const sec = body.match(/##[^\n]*一步步怎么配[\s\S]*?(?=\n##\s|\n---|$)/);
  if (!sec) return [];
  const text = sec[0];

  // 形态 A：有序列表 + 加粗小标题 —— 1. **先跑一次手动流程**。说明…
  let items = text.match(/^\s*\d+\.\s+\*\*(.+?)\*\*/gm) || [];
  if (items.length) {
    return items
      .map((s) => s.replace(/^\s*\d+\.\s+/, '').replace(/\*\*/g, '').trim());
  }

  // 形态 B：加粗段落 —— **第一步：先让它复述，别急着要结论**
  // （16 篇里两种写法都有，只认其中一种会让另一批文章的步骤条整体消失）
  items = text.match(/^\*\*第[一二三四五六七八九十\d]+步[：:](.+?)\*\*/gm) || [];
  if (items.length) {
    return items
      .map((s) =>
        s.replace(/^\*\*第[一二三四五六七八九十\d]+步[：:]/, '').replace(/\*\*/g, '').trim(),
      );
  }

  // 形态 C：普通有序列表（无加粗）—— 取第一句，避免把整段说明塞进步骤条
  return (text.match(/^\s*\d+\.\s+(.+)$/gm) || []).map((s) => {
    const t = s.replace(/^\s*\d+\.\s+/, '').replace(/\*\*/g, '').trim();
    const first = t.match(/^(.+?[。！？!?])/);
    return (first ? first[1] : t).trim();
  });
}
const steps = extractSteps(entry.body ?? '');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  showSubscribe={false}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  faqs={faqs}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '痛点处方', url: '/prescriptions' },
    { name: entry.data.role, url: '/prescriptions' },
  ]}
>
  <article class="pt-0 pb-[110px] bg-paper">
    <!-- 面包屑（与 BreadcrumbList schema 保持一致） -->
    <nav aria-label="面包屑" class="px-5 sm:px-8 lg:px-[120px] pt-[30px] pb-2 flex items-center gap-[9px]">
      <a href="/prescriptions" class="text-[13px] font-medium text-ink-3 hover:text-accent">痛点处方</a>
      <span class="text-ink-3" aria-hidden="true">/</span>
      <span class="text-[13px] font-medium text-ink-3">{entry.data.role}</span>
    </nav>

    <div class="px-5 sm:px-8 lg:px-[120px] flex justify-center">
      <div class="w-full max-w-[800px] flex flex-col gap-[26px]">
        <div class="flex gap-2">
          <a href="/prescriptions" class="tag bg-paper-2 text-ink-2 hover:text-accent">{entry.data.role}</a>
          <span class="tag bg-accent-tint text-accent">
            已验证 · 每周省 {entry.data.saveHoursPerWeek} 小时
          </span>
        </div>

        {(entry.data.tags || []).length > 0 && (
          <div class="flex gap-2 flex-wrap">
            {entry.data.tags.map((t) => (
              <a
                href={`/tags/${encodeURIComponent(t)}`}
                class="tag bg-paper-2 text-ink-2 border border-rule hover:border-accent hover:text-accent transition"
              >{t}</a>
            ))}
          </div>
        )}

        <h1 class="text-[46px] leading-[60px] font-bold font-display text-ink">
          {entry.data.title}
        </h1>

        <p class="text-[18px] leading-[32px] text-ink-2">{entry.data.summary}</p>

        <p class="text-[13px] font-medium text-ink-3 tracking-wide">
          {dateStr(entry.data.publishedAt)} 首发
          {entry.data.updatedAt && <> · {dateStr(entry.data.updatedAt)} 更新</>}
          · 读完约 {Math.max(4, Math.round(entry.data.setupMinutes / 3))} 分钟
        </p>

        <!-- 投入 / 回报对比条：数值全部取自 frontmatter 真实字段，不编造、不夸大 -->
        <div class="rx-compare">
          <div class="rx-compare-cell">
            <p class="rx-compare-k">一次上手</p>
            <p class="rx-compare-v">{entry.data.setupMinutes}<span class="rx-compare-u">分钟</span></p>
          </div>
          <span class="rx-compare-arrow" aria-hidden="true">→</span>
          <div class="rx-compare-cell">
            <p class="rx-compare-k">之后每周省</p>
            <p class="rx-compare-v rx-compare-v-accent">{entry.data.saveHoursPerWeek}<span class="rx-compare-u">小时</span></p>
          </div>
        </div>

        <hr class="border-t border-rule" />

        <!-- 步骤概览：从正文「一步步怎么配」自动提取（真实内容，非编造），
             解决「桌面 Agent 是操作软件，但全靠文字想象看不懂步骤」的问题 -->
        {steps.length > 0 && (
          <nav class="rx-steps" aria-label="配置步骤概览">
            <p class="rx-steps-label">先看全局 · 一共 {steps.length} 步</p>
            <ol class="rx-steps-list">
              {steps.map((s, i) => (
                <li class="rx-step">
                  <span class="rx-step-no" aria-hidden="true">{i + 1}</span>
                  <span class="rx-step-text">{s}</span>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="article-prose" id="article-body">
          <Content />
        </div>

        <!-- 一键复制整篇指令（核心卖点导出） -->
        <div class="rx-export-card">
          <div class="flex flex-col gap-1">
            <p class="text-[15px] font-semibold font-display text-ink">📋 一键复制本文全部可抄指令</p>
            <p class="text-[13px] text-ink-3">共 <span id="rx-cmd-count" class="font-mono text-ai-1">0</span> 段，已带章节标题，粘进 Agent 直接能用</p>
          </div>
          <button id="rx-copy-all" type="button" class="btn-ai h-[44px] px-[22px] text-[14px]">
            复制全部指令
          </button>
        </div>

        <script is:inline>
          // 一键复制整篇指令：聚合正文全部代码块，附章节标题
          (function () {
            var body = document.getElementById('article-body');
            var btn = document.getElementById('rx-copy-all');
            var cnt = document.getElementById('rx-cmd-count');
            if (!body || !btn) return;
            var pres = Array.prototype.slice.call(body.querySelectorAll('pre'));
            if (cnt) cnt.textContent = pres.length;
            if (!pres.length) { btn.disabled = true; btn.textContent = '本文暂无指令块'; return; }
            btn.addEventListener('click', function () {
              var parts = pres.map(function (pre) {
                var h = null, n = pre;
                while (n && n !== body) {
                  n = n.previousElementSibling;
                  if (n && (n.tagName === 'H2' || n.tagName === 'H3')) { h = n; break; }
                }
                var label = h ? h.textContent.replace(/^\s*[0-9]+[.、．]\s*/, '').trim() : '指令';
                return '## ' + label + '\n' + (pre.innerText || '').trim();
              });
              var text = parts.join('\n\n');
              function done() {
                var o = btn.textContent;
                btn.textContent = '已复制 ' + pres.length + ' 段 ✓';
                setTimeout(function () { btn.textContent = o; }, 1800);
              }
              if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(done, fallback);
              } else { fallback(); }
              function fallback() {
                var ta = document.createElement('textarea');
                ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = '复制失败'; }
                document.body.removeChild(ta);
              }
            });
          })();
        </script>

        <script is:inline>
          // 文章目录：从 h2 自动生成锚点胶囊条 + 「直接抄指令」快速定位
          (function () {
            var body = document.getElementById('article-body');
            if (!body) return;
            var heads = Array.prototype.slice.call(body.querySelectorAll('h2'));
            if (heads.length < 2) return;

            heads.forEach(function (h, i) {
              if (!h.id) h.id = 'sec-' + (i + 1);
            });

            var bar = document.createElement('nav');
            bar.className = 'toc-bar';
            bar.setAttribute('aria-label', '本页目录');
            var label = document.createElement('span');
            label.className = 'toc-bar-label';
            label.textContent = '目录';
            bar.appendChild(label);

            var links = [];
            heads.forEach(function (h) {
              var a = document.createElement('a');
              a.href = '#' + h.id;
              a.textContent = h.textContent.replace(/^\s*[0-9]+[.、．]\s*/, '');
              a.addEventListener('click', function (e) {
                e.preventDefault();
                var top = h.getBoundingClientRect().top + window.scrollY - 80;
                window.scrollTo({ top: top, behavior: 'smooth' });
                history.replaceState(null, '', '#' + h.id);
              });
              bar.appendChild(a);
              links.push(a);
            });

            // 「⚡ 直接抄指令」：直达可抄指令节（核心卖点）
            var jumpHead = heads.filter(function (h) { return /指令/.test(h.textContent); })[0] || null;
            var jump = null;
            if (jumpHead) {
              jump = document.createElement('a');
              jump.className = 'toc-jump';
              jump.href = '#' + jumpHead.id;
              jump.textContent = '⚡ 直接抄指令';
              jump.addEventListener('click', function (e) {
                e.preventDefault();
                var top = jumpHead.getBoundingClientRect().top + window.scrollY - 80;
                window.scrollTo({ top: top, behavior: 'smooth' });
                history.replaceState(null, '', '#' + jumpHead.id);
              });
              bar.appendChild(jump);
            }

            body.insertBefore(bar, body.firstChild);

            // 滚动高亮当前章节（克制：仅在滚动时切换，不做多余动画）
            if ('IntersectionObserver' in window) {
              var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                  if (en.isIntersecting) {
                    var idx = heads.indexOf(en.target);
                    links.forEach(function (l, i) { l.classList.toggle('is-active', i === idx); });
                    if (jump && en.target === jumpHead) jump.classList.add('is-active');
                    else if (jump) jump.classList.remove('is-active');
                  }
                });
              }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });
              heads.forEach(function (h) { io.observe(h); });
            }
          })();
        </script>

        <hr class="border-t border-rule mt-12" />

        <!-- 相关处方：主题集群内链，把权重聚到同类目 -->
        {related.length > 0 && (
          <section class="mt-2">
            <h2 class="text-[20px] font-bold font-display text-ink mb-4">相关的处方</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {related.map((r) => (
                <a
                  href={`/prescriptions/${r.id}`}
                  class="bg-white border border-rule rounded-[10px] ai-card p-5 flex flex-col gap-2 hover:border-accent transition"
                >
                  <p class="text-[12px] text-ink-3">{r.data.role}</p>
                  <p class="text-[16px] leading-[24px] font-semibold font-display text-ink">{r.data.title}</p>
                  <p class="text-[12px] text-accent mt-auto">每周省 {r.data.saveHoursPerWeek} 小时</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-10">
          {prev && (
            <a href={`/prescriptions/${prev.id}`} class="bg-white border border-rule rounded-[10px] ai-card p-[22px] flex flex-col gap-2 hover:border-accent transition">
              <p class="text-[12px] font-medium tracking-[1.2px] text-ink-3">上一篇</p>
              <p class="text-[17px] leading-[26px] font-semibold font-display text-ink">{prev.data.title}</p>
            </a>
          )}
          {next && (
            <a href={`/prescriptions/${next.id}`} class="bg-white border border-rule rounded-[10px] ai-card p-[22px] flex flex-col gap-2 hover:border-accent transition">
              <p class="text-[12px] font-medium tracking-[1.2px] text-ink-3">下一篇</p>
              <p class="text-[17px] leading-[26px] font-semibold font-display text-ink">{next.data.title}</p>
            </a>
          )}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
