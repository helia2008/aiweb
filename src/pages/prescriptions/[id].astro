---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const prescriptions = await getCollection('prescriptions');
  // 按 publishedAt 倒序：既用于上一篇/下一篇，也用于相关推荐的兜底
  const sorted = [...prescriptions].sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );

  return sorted.map((entry, i) => {
    // 相关处方：同类目优先（主题集群内链），不足则用最新的补齐
    const sameCategory = sorted.filter(
      (p) => p.id !== entry.id && p.data.category === entry.data.category,
    );
    const rest = sorted.filter(
      (p) => p.id !== entry.id && p.data.category !== entry.data.category,
    );
    const related = [...sameCategory, ...rest].slice(0, 3);

    return {
      params: { id: entry.id },
      props: {
        entry,
        prev: sorted[i - 1] ?? null,
        next: sorted[i + 1] ?? null,
        related,
      },
    };
  });
}

const { entry, prev, next, related } = Astro.props;
const { Content } = await render(entry);

const dateStr = (d: Date) => d.toISOString().slice(0, 10);

// FAQ：文章可在 frontmatter 里写 faqs（数组），写了才输出 FAQPage schema。
// 没有真实 Q&A 就不要硬造——PAA 富摘要要靠真问题，不是模板。
const faqs = entry.data.faqs ?? [];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  showSubscribe={false}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  faqs={faqs}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '痛点处方', url: '/prescriptions' },
    { name: entry.data.category, url: '/prescriptions' },
  ]}
>
  <article class="pt-0 pb-[110px] bg-paper">
    <!-- 面包屑（与 BreadcrumbList schema 保持一致） -->
    <nav aria-label="面包屑" class="px-5 sm:px-8 lg:px-[120px] pt-[30px] pb-2 flex items-center gap-[9px]">
      <a href="/prescriptions" class="text-[13px] font-medium text-ink-3 hover:text-accent">痛点处方</a>
      <span class="text-ink-3" aria-hidden="true">/</span>
      <span class="text-[13px] font-medium text-ink-3">{entry.data.category}</span>
    </nav>

    <div class="px-5 sm:px-8 lg:px-[120px] flex justify-center">
      <div class="w-full max-w-[800px] flex flex-col gap-[26px]">
        <div class="flex gap-2">
          <a href="/prescriptions" class="tag bg-paper-2 text-ink-2 hover:text-accent">{entry.data.category}</a>
          <span class="tag bg-accent-tint text-accent">
            已验证 · 每周省 {entry.data.saveHoursPerWeek} 小时
          </span>
        </div>

        <h1 class="text-[46px] leading-[60px] font-bold font-display text-ink">
          {entry.data.title}
        </h1>

        <p class="text-[18px] leading-[32px] text-ink-2">{entry.data.summary}</p>

        <p class="text-[13px] font-medium text-ink-3 tracking-wide">
          {dateStr(entry.data.publishedAt)} 首发
          {entry.data.updatedAt && <> · {dateStr(entry.data.updatedAt)} 更新</>}
          · 读完约 {Math.max(4, Math.round(entry.data.setupMinutes / 3))} 分钟
        </p>

        <hr class="border-t border-rule" />

        <div class="article-prose">
          <Content />
        </div>

        <hr class="border-t border-rule mt-12" />

        <!-- 相关处方：主题集群内链，把权重聚到同类目 -->
        {related.length > 0 && (
          <section class="mt-2">
            <h2 class="text-[20px] font-bold font-display text-ink mb-4">相关的处方</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {related.map((r) => (
                <a
                  href={`/prescriptions/${r.id}`}
                  class="bg-white border border-rule rounded-[10px] ai-card p-5 flex flex-col gap-2 hover:border-accent transition"
                >
                  <p class="text-[12px] text-ink-3">{r.data.category}</p>
                  <p class="text-[16px] leading-[24px] font-semibold font-display text-ink">{r.data.title}</p>
                  <p class="text-[12px] text-accent mt-auto">每周省 {r.data.saveHoursPerWeek} 小时</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-10">
          {prev && (
            <a href={`/prescriptions/${prev.id}`} class="bg-white border border-rule rounded-[10px] ai-card p-[22px] flex flex-col gap-2 hover:border-accent transition">
              <p class="text-[12px] font-medium tracking-[1.2px] text-ink-3">上一篇</p>
              <p class="text-[17px] leading-[26px] font-semibold font-display text-ink">{prev.data.title}</p>
            </a>
          )}
          {next && (
            <a href={`/prescriptions/${next.id}`} class="bg-white border border-rule rounded-[10px] ai-card p-[22px] flex flex-col gap-2 hover:border-accent transition">
              <p class="text-[12px] font-medium tracking-[1.2px] text-ink-3">下一篇</p>
              <p class="text-[17px] leading-[26px] font-semibold font-display text-ink">{next.data.title}</p>
            </a>
          )}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
