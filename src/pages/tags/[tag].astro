---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const prescriptions = await getCollection('prescriptions', ({ data }) => !data.draft);
  const all = new Set();
  prescriptions.forEach((p) => (p.data.tags || []).forEach((t) => all.add(t)));

  return [...all].map((tag) => ({
    params: { tag },
    props: {
      tag,
      items: prescriptions
        .filter((p) => (p.data.tags || []).includes(tag))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()),
    },
  }));
}

const { tag, items } = Astro.props;
---

<BaseLayout
  title={`${tag} · 标签`}
  description={`标签「${tag}」下的全部处方，共 ${items.length} 篇。`}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '标签', url: '/tags' },
    { name: tag, url: `/tags/${encodeURIComponent(tag)}` },
  ]}
>
  <section class="px-5 sm:px-8 lg:px-[120px] py-[80px] bg-paper">
    <div class="flex flex-col gap-4 max-w-[820px]">
      <a href="/tags" class="mono-badge text-ai-1 hover:underline w-fit">← 全部标签</a>
      <h1 class="text-[44px] leading-[56px] font-bold font-display">{tag}</h1>
      <p class="text-[17px] leading-[31px] text-ink-2 mt-1">共 {items.length} 篇</p>
    </div>
  </section>

  <section class="px-5 sm:px-8 lg:px-[120px] pb-[100px] bg-paper">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      {
        items.map((p) => (
          <a
            href={`/prescriptions/${p.id}`}
            class="bg-white border border-rule rounded-[12px] ai-card p-[24px] flex flex-col gap-[13px]"
          >
            <div class="flex gap-2 flex-wrap">
              <span class="tag bg-paper-2 text-ink-2">{p.data.role}</span>
              <span class="tag bg-accent-tint text-accent">上手 {p.data.setupMinutes} 分钟</span>
            </div>
            <h2 class="text-[19px] leading-[28px] font-semibold font-display text-ink">
              {p.data.title}
            </h2>
            <p class="text-[14px] leading-[24px] text-ink-2 line-clamp-3">{p.data.summary}</p>
            <p class="text-[13px] text-ink-3 font-medium mt-auto pt-1">
              每周省 {p.data.saveHoursPerWeek} 小时
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
