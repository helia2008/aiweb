---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const prescriptions = (await getCollection('prescriptions', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured = prescriptions.slice(0, 3);
const tools = await getCollection('tools');

// 分类 tab：从全部处方去重得到类目（用于首页「痛点处方」区筛选）
const categories = ['全部', ...Array.from(new Set(prescriptions.map((p) => p.data.category)))];
// 微数据条比例：以最大「每周省 X 小时」为满格基准
const maxSave = Math.max(...prescriptions.map((p) => p.data.saveHoursPerWeek || 0), 1);

// 真实统计：把每篇处方自测的「每周省 X 小时」按每月 4.3 周合计。
// 口径写在页面上，不编造——这是文章自身声明的加总，不是虚构的读者数据。
const totalHoursPerMonth = Math.round(
  prescriptions.reduce((sum, p) => sum + (p.data.saveHoursPerWeek || 0), 0) * 4.3,
);
---

<BaseLayout
  title="让 AI Agent 替你做每周重复的活"
  description="不懂代码也能用。按岗位整理的可复现自动化处方：报销单、合同条款、简历初筛、周报、竞品监控——每一步都自己跑过一遍才写出来。"
>
  <!-- ============== HERO（AI 渐变） ============== -->
  <section class="hero-ai px-5 sm:px-8 lg:px-[120px] py-16 lg:py-[104px]">
    <!-- 装饰光晕 -->
    <span class="ai-blob w-[420px] h-[420px] bg-ai-1 -top-24 -left-24" aria-hidden="true"></span>
    <span class="ai-blob w-[320px] h-[320px] bg-ai-2 bottom-0 right-[8%]" aria-hidden="true"></span>

    <div class="relative flex flex-col lg:flex-row items-center gap-12 lg:gap-[72px]">
      <div class="w-full lg:w-full max-w-[600px] flex flex-col gap-[26px] lg:gap-[30px]">
        <span class="inline-flex items-center gap-[9px] px-[15px] py-[8px] rounded-full glass-dark w-fit">
          <span class="block w-[6px] h-[6px] rounded-full bg-ai-glow animate-pulse"></span>
          <span class="mono-badge text-deep-ink-2">只写自己跑通过的 · 每周三更新</span>
        </span>

        <h1 class="text-[38px] sm:text-[46px] lg:text-[58px] leading-[1.25] lg:leading-[74px] font-bold font-display text-deep-ink">
          把你每周重复做的那件事，<span class="gradient-text-light">交给电脑自己做</span>
        </h1>

        <p class="text-[16px] lg:text-[17px] leading-[28px] lg:leading-[31px] text-deep-ink-2">
          这里不做工具评测，也不讲大模型原理。只记录一件事：一个不懂代码的普通人，怎么用桌面 Agent 把每周三小时的手工活，压缩成一次回车。
        </p>

        <div class="flex flex-col sm:flex-row gap-[14px] mt-2">
          <a href="/start-here" class="h-[52px] px-7 inline-flex items-center justify-center btn-ai text-[16px]">
            从 7 天路线开始
          </a>
          <a href="/prescriptions" class="h-[52px] px-7 inline-flex items-center justify-center glass-dark rounded-[10px] text-[16px] font-medium text-deep-ink hover:border-ai-glow/50 transition">
            先看看能省多少时间
          </a>
        </div>

        <p class="text-[13px] lg:text-[14px] text-deep-ink-3 mt-2 font-medium">
          <span class="font-mono text-deep-ink-2">{prescriptions.length}</span> 篇已验证处方 ·
          按文中自测口径合计约 <span class="font-mono text-ai-glow">{totalHoursPerMonth}</span> 小时/月
        </p>
      </div>

      <div class="w-full lg:flex-1 flex justify-center relative">
        <!-- Agent 终端窗口演示（替代实景照片，AI 感核心视觉） -->
        <span class="agent-window-glow" aria-hidden="true"></span>
        <div class="agent-window" role="img" aria-label="桌面 Agent 正在自动合并门店销售表的演示窗口">
          <div class="aw-titlebar">
            <span class="aw-dot" style="background:#FF5F57"></span>
            <span class="aw-dot" style="background:#FEBC2E"></span>
            <span class="aw-dot" style="background:#28C840"></span>
            <span class="aw-title">Agent · 合并 12 家门店销售表</span>
          </div>
          <div class="aw-body">
            <div class="aw-line aw-ok l1"><b>读取</b> 12 家门店的销售表（Excel）</div>
            <div class="aw-line aw-ok l2"><b>对齐</b> 表头与日期格式，去重 3 处重复行</div>
            <div class="aw-line aw-ok l3"><b>合并</b> 384 行 → 一张总表</div>
            <div class="aw-line aw-pending l4"><b>校验</b> 金额合计，2 处差异已标黄</div>
            <div class="aw-line aw-pending l5"><b>导出</b> 汇总表.xlsx 到桌面<span class="aw-cursor"></span></div>
            <div class="aw-result">
              原耗时 <b class="g">3 小时</b> → 现在 <b class="g">8 分钟</b> · 你只负责抽查
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== BEFORE / AFTER ============== -->
  <section class="px-5 sm:px-8 lg:px-[120px] py-[86px] bg-deep">
    <div class="flex flex-col gap-[44px]">
      <div class="flex flex-col gap-[14px]">
        <p class="text-[13px] font-medium tracking-[1.6px] text-accent">为什么值得花这 7 天</p>
        <h2 class="text-[38px] leading-[50px] font-bold font-display text-deep-ink">三个月前，和三个月后</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 reveal">
        <div class="bg-deep-2 rounded-[12px] p-[34px] flex flex-col gap-[22px]">
          <p class="text-[12px] font-medium tracking-[2px] text-deep-ink-3">BEFORE</p>
          <h3 class="text-[23px] leading-[34px] font-semibold font-display text-deep-ink">每周三下午，你还在手工对 400 行表格</h3>
          <ul class="flex flex-col gap-[10px]">
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-3"><span class="block w-[5px] h-[5px] rounded-full bg-deep-ink-3"></span>复制、粘贴、改格式，一坐就是三小时</li>
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-3"><span class="block w-[5px] h-[5px] rounded-full bg-deep-ink-3"></span>换个人接手，流程又得从头讲一遍</li>
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-3"><span class="block w-[5px] h-[5px] rounded-full bg-deep-ink-3"></span>AI 试过一次，答非所问，就再没打开过</li>
          </ul>
        </div>

        <div class="bg-deep-3 border border-accent rounded-[12px] p-[34px] flex flex-col gap-[22px]">
          <p class="text-[12px] font-medium tracking-[2px] text-accent">AFTER</p>
          <h3 class="text-[23px] leading-[34px] font-semibold font-display text-deep-ink">你说一句，它跑完，你去泡杯咖啡</h3>
          <ul class="flex flex-col gap-[10px]">
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-2"><span class="block w-[5px] h-[5px] rounded-full bg-accent"></span>表格丢给 Agent，八分钟出结果，你只负责抽查</li>
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-2"><span class="block w-[5px] h-[5px] rounded-full bg-accent"></span>流程写成一份说明书，谁接手都能照着跑</li>
            <li class="flex gap-3 items-center text-[15px] leading-[26px] text-deep-ink-2"><span class="block w-[5px] h-[5px] rounded-full bg-accent"></span>省下的时间拿去做只有人能做的判断</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== START HERE ============== -->
  <section class="px-5 sm:px-8 lg:px-[120px] py-[92px] bg-paper">
    <div class="flex flex-col gap-[46px]">
      <div class="flex flex-col gap-4">
        <p class="mono-badge text-ai-1">START HERE</p>
        <h2 class="text-[40px] leading-[52px] font-bold font-display text-ink">挑一条路，七天后来验收</h2>
        <p class="text-[16px] leading-[29px] text-ink-2 max-w-[920px]">
          三条路线都实测过：跟着做，第七天手上会有一个真跑得起来的自动化。不需要懂代码，也不需要装任何付费软件。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
        <a href="/start-here#p1" class="bg-white border border-rule rounded-[12px] ai-card p-8 flex flex-col gap-4 hover:border-accent transition">
          <span class="text-[42px] font-bold font-display text-rule">01</span>
          <h3 class="text-[21px] leading-[31px] font-semibold font-display text-ink">我连提示词都写不明白</h3>
          <p class="text-[15px] leading-[27px] text-ink-2">从装好第一个桌面 Agent 开始，到让它帮你读完一份 40 页 PDF 并写出摘要。全程鼠标操作。</p>
          <div class="h-px bg-rule my-2"></div>
          <p class="text-[13px] text-ink-3 font-medium">7 天 · 每天 20 分钟 · 零基础</p>
        </a>
        <a href="/start-here#p2" class="bg-white border border-rule rounded-[12px] ai-card p-8 flex flex-col gap-4 hover:border-accent transition">
          <span class="text-[42px] font-bold font-display text-rule">02</span>
          <h3 class="text-[21px] leading-[31px] font-semibold font-display text-ink">我想让它替我干掉一份周报</h3>
          <p class="text-[15px] leading-[27px] text-ink-2">挑一件你每周必做、最厌烦的事，把它拆成 Agent 能执行的步骤，配上可复用的指令模板。</p>
          <div class="h-px bg-rule my-2"></div>
          <p class="text-[13px] text-ink-3 font-medium">7 天 · 每天 30 分钟 · 会用 Excel</p>
        </a>
        <a href="/start-here#p3" class="bg-white border border-rule rounded-[12px] ai-card p-8 flex flex-col gap-4 hover:border-accent transition">
          <span class="text-[42px] font-bold font-display text-rule">03</span>
          <h3 class="text-[21px] leading-[31px] font-semibold font-display text-ink">我们部门都想用起来</h3>
          <p class="text-[15px] leading-[27px] text-ink-2">从个人提效跨到团队落地：怎么选场景、怎么定红线、怎么让同事愿意跟着用而不是偷偷抵触。</p>
          <div class="h-px bg-rule my-2"></div>
          <p class="text-[13px] text-ink-3 font-medium">7 天 · 每天 40 分钟 · 带团队</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ============== 痛点处方 ============== -->
  <section class="px-5 sm:px-8 lg:px-[120px] py-[92px] bg-paper-2">
    <div class="flex flex-col gap-[42px]">
      <div class="flex items-end justify-between">
        <div class="flex flex-col gap-4 max-w-[760px]">
          <p class="mono-badge text-ai-1">痛点处方</p>
          <h2 class="text-[40px] leading-[52px] font-bold font-display text-ink">按你烦的那件事找，不按工具找</h2>
          <p class="text-[16px] leading-[29px] text-ink-2">每篇都是同一个结构：这个活烦在哪 → 需要准备什么 → 一步步怎么配 → 直接能抄的指令 → 我踩过的坑。</p>
        </div>
        <a href="/start-here" class="text-[15px] font-medium text-accent hover:underline">新手从这里开始 →</a>
      </div>

      <!-- 分类筛选 tab -->
      <div class="cat-tabs reveal" role="tablist" aria-label="按类目筛选处方">
        {
          categories.map((c, i) => (
            <button
              type="button"
              class:list={['cat-tab', i === 0 && 'is-active']}
              data-filter={c}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c}
            </button>
          ))
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 reveal" id="rx-grid">
        {
          prescriptions.map((p) => (
            <a
              href={`/prescriptions/${p.id}`}
              data-category={p.data.category}
              class="bg-white border border-rule rounded-[12px] ai-card p-[24px] flex flex-col gap-[13px] hover:border-accent transition"
            >
              <div class="flex gap-2 flex-wrap">
                <span class="tag bg-paper-2 text-ink-2">{p.data.category}</span>
                <span class="tag bg-accent-tint text-accent">上手 {p.data.setupMinutes} 分钟</span>
              </div>
              <h3 class="text-[20px] leading-[29px] font-semibold font-display text-ink">{p.data.title}</h3>
              <p class="text-[14px] leading-[24px] text-ink-2 line-clamp-2">{p.data.summary}</p>
              <p class="text-[13px] text-ink-3 font-medium mt-auto pt-1">
                每周省 {p.data.saveHoursPerWeek} 小时
              </p>
              <div class="rx-savebar" aria-hidden="true" title={`每周省 ${p.data.saveHoursPerWeek} 小时`}>
                <span class="rx-savebar-fill" style={`--save:${Math.round((p.data.saveHoursPerWeek / maxSave) * 100)}%`}></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
    // 首页「痛点处方」分类筛选
    (function () {
      var tabs = document.querySelectorAll('#rx-grid, .cat-tabs');
      var tabBar = document.querySelector('.cat-tabs');
      var grid = document.getElementById('rx-grid');
      if (!tabBar || !grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-category]'));
      tabBar.addEventListener('click', function (e) {
        var btn = e.target.closest('.cat-tab');
        if (!btn) return;
        var f = btn.getAttribute('data-filter');
        tabBar.querySelectorAll('.cat-tab').forEach(function (t) {
          var on = t === btn;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        cards.forEach(function (c) {
          var show = f === '全部' || c.getAttribute('data-category') === f;
          c.style.display = show ? '' : 'none';
        });
      });
    })();
  </script>

  <!-- ============== 工具罗盘 ============== -->
  <section class="px-5 sm:px-8 lg:px-[120px] py-[92px] bg-paper">
    <div class="flex flex-col gap-[42px]">
      <div class="flex flex-col gap-4">
        <p class="mono-badge text-ai-1">工具罗盘</p>
        <h2 class="text-[40px] leading-[52px] font-bold font-display text-ink">只收我自己在用的，并且都标了不适合谁</h2>
        <p class="text-[16px] leading-[29px] text-ink-2">工具站最大的问题是不说人话的坏处。这里每张卡都会告诉你：什么情况下别用它。</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          tools.map((t) => (
            <a
              href="/tools"
              class="bg-white border border-rule rounded-[12px] ai-card p-[30px] flex flex-col gap-[11px] hover:border-accent transition"
            >
              <h3 class="text-[20px] font-semibold">{t.data.name}</h3>
              <p class="text-[13px] font-medium text-accent">{t.data.tag}</p>
              <p class="text-[14px] leading-[25px] text-ink-2 line-clamp-3">{t.data.fit[0]}</p>
              <div class="h-px bg-rule my-2"></div>
              <p class="text-[13px] font-medium text-ink-3">上手 {t.data.setupTime} · {t.data.cost}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============== 痛点门诊 ============== -->
  <section class="px-5 sm:px-8 lg:px-[120px] py-[84px] bg-accent-tint">
    <div class="flex flex-col gap-[26px] max-w-[920px]">
      <p class="mono-badge text-ai-1">痛点门诊</p>
      <h2 class="text-[38px] leading-[50px] font-bold font-display text-ink">把你最烦的那件事丢过来</h2>
      <p class="text-[16px] leading-[29px] text-ink-2">
        描述你每周重复做的那件事，我来判断它值不值得自动化、大概能省多少时间，跑通了就写成一篇处方发出来。每周挑三个。
      </p>
      <!--
        2026-09-04 修复：原来用 <form action="mailto:" method="post">，
        Chrome/Edge 等主流浏览器不支持 POST mailto，用户输入的痛点会静默丢失。
        改为：JS 把输入内容拼进 mailto 链接的 subject/body 再跳转——任何浏览器都可靠。
      -->
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id="pain-input"
          type="text"
          placeholder="比如：每周一要把 12 家门店的销售表合成一张"
          class="flex-1 h-[58px] px-[22px] rounded-[9px] bg-white border border-rule text-[15px] focus:outline-none focus:border-ai-1"
        />
        <button
          id="pain-submit"
          type="button"
          class="h-[58px] px-8 rounded-[9px] btn-ai text-[16px] justify-center"
        >提交</button>
      </div>
      <p class="text-[13px] font-medium text-ink-3">
        点提交会自动打开邮件客户端并带上你写的内容。<b class="text-ink-2">也可以直接写信到</b>
        <a href="mailto:admin@aiwind.eu.cc" class="text-ai-1 underline">admin@aiwind.eu.cc</a> · 每周挑选 3 个真实痛点写成处方
      </p>

      <script is:inline>
        (function () {
          var input = document.getElementById('pain-input');
          var btn = document.getElementById('pain-submit');
          if (!input || !btn) return;
          function send() {
            var text = (input.value || '').trim();
            if (!text) {
              alert('先写一句你每周重复做的那件事，再点提交。');
              input.focus();
              return;
            }
            var subject = encodeURIComponent('【痛点门诊】' + text.slice(0, 40));
            var body = encodeURIComponent(
              '我最烦的重复劳动是：\n' + text + '\n\n' +
              '（建议补充）多久做一次：\n每次大概花：\n现在怎么做的：\n'
            );
            window.location.href =
              'mailto:admin@aiwind.eu.cc?subject=' + subject + '&body=' + body;
          }
          btn.addEventListener('click', send);
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') send();
          });
        })();
      </script>
    </div>
  </section>
</BaseLayout>
