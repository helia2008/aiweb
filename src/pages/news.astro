---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * 资讯雷达（2026-09-15 新增板块）
 * 定位：不替你做新闻聚合（静态站做不到实时），而是两件更实在的事：
 * 1) 告诉你「每天该去哪看」——3 个一手信息源，带看法与节奏建议；
 * 2) 给你一份精选博主清单——X 中英文区，每条写清「看什么」，不堆名字。
 * 博主清单按 2026-09 多来源交叉核对（含 handle），只收长期稳定输出的账号。
 */

const sources = [
  {
    name: 'GitHub Trending',
    url: 'https://github.com/trending',
    tag: '开源风向标',
    what: '每天/每周被 star 最多的开源项目。AI Agent、本地模型、自动化工具往往先在这里冒头。',
    how: '每天扫一眼日榜，周末看周榜。重点看 star 增速而不是总量——增速代表「正在发生」。',
    cadence: '每天 3 分钟',
  },
  {
    name: 'Product Hunt',
    url: 'https://www.producthunt.com/',
    tag: '新产品首发地',
    what: '全球新产品的首发舞台。AI 工具、浏览器插件、效率应用几乎都会来这里打首发。',
    how: '看当日 Top 5 就够。注意分辨：有 demo 视频 + 创始人亲自答评论的，通常比纯营销页靠谱。',
    cadence: '每天 3 分钟',
  },
  {
    name: 'AI Base 新闻',
    url: 'https://news.aibase.com/',
    tag: 'AI 资讯聚合',
    what: '中文友好的 AI 资讯聚合：新模型发布、融资动态、大厂产品更新，按时间线整理。',
    how: '适合「今天 AI 圈发生了什么」的补课——不刷 X 的人靠它保持不掉队。',
    cadence: '每天 2 分钟',
  },
];

const bloggersCN = [
  {
    name: '宝玉',
    handle: 'dotey',
    role: 'AI 实战与提示词工程',
    why: '中文 AI 圈高频信息源：提示词技巧、模型解读、前沿工具，翻译和点评都快且准。新手第一关注。',
  },
  {
    name: '歸藏',
    handle: 'op7418',
    role: 'AIGC / 设计工作流',
    why: 'AIGC 周刊主理人。AI 绘画、视频生成、设计工作流的趋势观察，创意方向必看。',
  },
  {
    name: '向阳乔木',
    handle: 'vista8',
    role: 'AI 产品与工作流',
    why: '偏 AI 产品、工作流和 Vibe Coding，兼具产品感和表达力，读完能直接抄做法。',
  },
  {
    name: 'Axton',
    handle: 'AxtonLiu',
    role: '技术科普与方法论',
    why: '擅长把复杂 AI 技术讲清楚：产品、开发实践、工具应用心得，信息密度高。',
  },
  {
    name: '李继刚',
    handle: 'lijigang_com',
    role: '提示词与创意应用',
    why: '提示词时代的代表人物：AI 思考、创意应用与方法论总结，看想法比看教程更有收获。',
  },
  {
    name: '小互',
    handle: 'imxiaohu',
    role: 'AI 资讯日报',
    why: '每天的第一手 AI 资讯和动态整理，适合当「信息流水线」——快，但记得交叉验证。',
  },
  {
    name: 'WaytoAGI',
    handle: 'WaytoAGI',
    role: '体系化 AI 知识库',
    why: '中文 AI 知识整理型头部账号，适合想系统学习而不是只刷碎片的人。',
  },
];

const bloggersEN = [
  {
    name: 'Andrej Karpathy',
    handle: 'karpathy',
    role: '模型原理第一解读',
    why: 'OpenAI 创始成员、前 Tesla AI 负责人，2026 年加入 Anthropic。能把 LLM 讲到普通工程师懂，「vibe coding」就是他提出的。',
  },
  {
    name: 'Simon Willison',
    handle: 'simonw',
    role: 'LLM 工程实践',
    why: '构建 LLM 应用的最高价值关注：真实 prompt、真实翻车、工具链拆解。他写 prompt injection 的文章是行业引用标准。',
  },
  {
    name: 'Ethan Mollick',
    handle: 'emollick',
    role: 'AI 与工作实证研究',
    why: '沃顿商学院教授。研究「普通人到底该怎么用 AI」，自己跑实验再发结论，不传二手恐慌。',
  },
  {
    name: 'swyx',
    handle: 'swyx',
    role: 'AI 工程生态地图',
    why: '「AI Engineer」概念提出者、Latent Space 播客主理人。他的时间线像行业目录：哪些工具、模式正在真被采用。',
  },
  {
    name: 'Andrew Ng',
    handle: 'AndrewYNg',
    role: '应用 AI 教育',
    why: '吴恩达。低频但每次都有干货：课程、工程模式、劳动力市场观察，适合不追热点只看方向的人。',
  },
  {
    name: 'Jim Fan',
    handle: 'DrJimFan',
    role: '具身智能 / 机器人',
    why: 'NVIDIA 研究员，物理 AI 与机器人方向的代表声音，演示视频质量极高。',
  },
  {
    name: 'Logan Kilpatrick',
    handle: 'OfficialLoganK',
    role: 'Gemini 生态与开发者动态',
    why: 'Google AI Studio / Gemini API 负责人，曾负责 OpenAI 开发者关系。两家亲历者视角，产品发布一手信息。',
  },
  {
    name: 'Demis Hassabis',
    handle: 'demishassabis',
    role: '前沿研究里程碑',
    why: 'DeepMind 联合创始人、诺贝尔奖得主。发帖少但条条重磅：里程碑论文、科学应用、长期视角。',
  },
];

/**
 * 今日 Top 10 快照（2026-09-15 抓取，静态站快照——每周随工具精选一起刷新）
 * 三个源、三种「点击量」口径：
 * - GitHub Trending：今日新增 Star（增速代表「正在发生」）
 * - Product Hunt：当日产品榜排名 + 赞数
 * - AI Base：新闻页浏览量（K = 千次）
 * 全部为抓取当日的一手数据，英文标题已翻译为中文，链接直达原文。
 */
const ghTop = [
  { name: 'debpalash/VoiceStudio', desc: '开源全本地的 ElevenLabs 替代：声音克隆、视频配音、转写与有声书，646 种语言。', lang: 'Python', metric: '+2,774', url: 'https://github.com/debpalash/VoiceStudio' },
  { name: 'JustVugg/colibri', desc: '在你已有的硬件上跑前沿 MoE 大模型：纯 C、零依赖，专家权重从磁盘流式加载。', lang: 'C', metric: '+2,233', url: 'https://github.com/JustVugg/colibri' },
  { name: 'alibaba/open-code-review', desc: '混合架构代码审查：确定性流水线 + LLM Agent，行级精准评论，内置多语言规则集。', lang: 'Go', metric: '+1,796', url: 'https://github.com/alibaba/open-code-review' },
  { name: 'ever-co/ever-gauzy', desc: '开源业务管理平台：ERP / CRM / HRM / ATS / PM 一体。', lang: 'TypeScript', metric: '+1,095', url: 'https://github.com/ever-co/ever-gauzy' },
  { name: 'asgeirtj/system_prompts_leaks', desc: 'Claude、ChatGPT、Gemini、Grok 等各家模型的真实系统提示词合集，持续更新。', lang: 'JavaScript', metric: '+770', url: 'https://github.com/asgeirtj/system_prompts_leaks' },
  { name: 'TauricResearch/TradingAgents', desc: '多 Agent LLM 金融交易框架。', lang: 'Python', metric: '+756', url: 'https://github.com/TauricResearch/TradingAgents' },
  { name: 'Panniantong/Agent-Reach', desc: '给 Agent 全网之眼：一个 CLI 读搜推特、Reddit、YouTube、B站、小红书，零 API 费。', lang: 'Python', metric: '+640', url: 'https://github.com/Panniantong/Agent-Reach' },
  { name: 'multimodal-art-projection/YuE', desc: 'YuE2 前沿音乐生成：符号规划、零样本翻唱、Agent 式音乐编辑。', lang: 'Python', metric: '+578', url: 'https://github.com/multimodal-art-projection/YuE' },
  { name: 'huggingface/transformers', desc: 'Hugging Face 模型定义框架：文本、视觉、音频与多模态模型统一接口。', lang: 'Python', metric: '+528', url: 'https://github.com/huggingface/transformers' },
  { name: '666ghj/MiroFish', desc: '简洁通用的群体智能引擎，预测万物。', lang: 'Python', metric: '+524', url: 'https://github.com/666ghj/MiroFish' },
];

const phTop = [
  { name: 'Naoma AI Demo Agent V2', desc: '把网站访客流量自动变成预约好的合格会议。', metric: '158 赞', url: 'https://www.producthunt.com/' },
  { name: 'Web Search Agents by Nimble', desc: '自学习 Agent 自动完成网络检索与信息提取。', metric: '45 赞', url: 'https://www.producthunt.com/' },
  { name: 'Hello Inbox', desc: '让营销邮件更多送达收件箱（送达率优化）。', metric: '39 赞', url: 'https://www.producthunt.com/' },
  { name: 'Slashy Assistant', desc: '替你处理邮件的 AI 助手。', metric: '74 赞', url: 'https://www.producthunt.com/' },
  { name: 'Oats', desc: '免费、开源、本地运行的 AI 会议记录器。', metric: '68 赞', url: 'https://www.producthunt.com/' },
  { name: 'Elva', desc: '再见 Postman：你的 API 迎来新消费者（AI Agent）。', metric: '50 赞', url: 'https://www.producthunt.com/' },
  { name: 'Aside', desc: '真正替你干活的 AI 浏览器。', metric: '33 赞', url: 'https://www.producthunt.com/' },
  { name: 'LLMagnet', desc: '让你的 WordPress 网站被 AI 看见（AI 搜索优化）。', metric: '54 赞', url: 'https://www.producthunt.com/' },
  { name: 'AppZapper 3000', desc: '苹果忘了做的卸载器。', metric: '3 赞', url: 'https://www.producthunt.com/' },
  { name: 'OzBrain', desc: '把你的知识共享给所有 AI Agent 和团队成员。', metric: '13 赞', url: 'https://www.producthunt.com/' },
];

const aibaseTop = [
  { name: '传 DeepSeek 下一代大模型将至：3 万亿参数，性能对标 GPT-6 Astra', desc: '本周已发 V4.1 Flash；V4.1 Pro 已确认，Code 2.0 也曝光在即。', metric: '15.4K 浏览', url: 'https://news.aibase.com/news/31026' },
  { name: 'DeepSeek-V4.1-Flash 登陆千问平台', desc: '552B MoE 架构、激活约 8B，原生图文理解，上下文百万 token。', metric: '13.9K 浏览', url: 'https://news.aibase.com/news/31028' },
  { name: '开源编码工具 OpenCode Go 宣布盈亏平衡', desc: '月费仅 10 美元，连续两周打平——低成本 AI 订阅模式的商业突破。', metric: '13.5K 浏览', url: 'https://news.aibase.com/news/31022' },
  { name: 'GPT-6 Astra 模拟自动售货机一年净赚 1.5 万美元', desc: 'Vending-Bench2 榜首，最差成绩也超过 Claude 的最好成绩，近 3 倍。', metric: '13.1K 浏览', url: 'https://news.aibase.com/news/31035' },
  { name: 'OpenAI 关停最快模型 GPT-5.3-Codex-Spark', desc: '1200 tokens/秒，从发布到退役仅 7 个月，让位给后续模型。', metric: '13.1K 浏览', url: 'https://news.aibase.com/news/31021' },
  { name: 'Anthropic 与 Rum Group 签下 137 亿美元算力协议', desc: '六年期采购，为一年来的算力扩张再添一家供应商。', metric: '13.1K 浏览', url: 'https://news.aibase.com/news/31019' },
  { name: 'OpenAI 推出 Agents API', desc: 'Codex 能力拆分为云服务，「能力即服务」——从卖模型转向建开发者生态。', metric: '12.4K 浏览', url: 'https://news.aibase.com/news/31025' },
  { name: 'Suno 发布音乐模型 v6', desc: '携手华纳、BMG：自然语言即可改歌、混音、采样，旗舰版面向 Pro 用户。', metric: '12.4K 浏览', url: 'https://news.aibase.com/news/31033' },
  { name: '蓝虫具身发布模块化人形机器人「小白」', desc: '西交大成果转化，基座/手臂/腰部/头部标准模块自由组合，起价 0.98 万元。', metric: '12.4K 浏览', url: 'https://news.aibase.com/news/31038' },
  { name: 'YC CEO 反对禁止模型蒸馏', desc: '「与其禁止，不如让开源实验室通过正道合法获取能力」。', metric: '12.0K 浏览', url: 'https://news.aibase.com/news/31037' },
];
---

<BaseLayout
  title="资讯雷达 · 每天 10 分钟不落后"
  description="AI 资讯不用刷一天：3 个一手信息源（GitHub Trending / Product Hunt / AI Base）+ X 中英文区精选 AI 博主清单，每条都写清「看什么」。"
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '资讯雷达', url: '/news' },
  ]}
>
  <section class="px-5 sm:px-8 lg:px-[120px] py-[80px] bg-paper">
    <div class="flex flex-col gap-4 max-w-[860px]">
      <p class="mono-badge text-ai-1">资讯雷达</p>
      <h1 class="text-[48px] leading-[60px] font-bold font-display">
        每天 10 分钟，不落后
      </h1>
      <p class="text-[17px] leading-[31px] text-ink-2 mt-2">
        AI 资讯最大的坑不是少，是<b class="text-ink">多到刷不完</b>。这个板块不替你聚合新闻（聚合出来的都是二手），
        只做两件事：告诉你<b class="text-ink">该去哪看一手信息</b>，以及给你一份
        <b class="text-ink">值得长期关注的博主清单</b>——每条都写清「看什么」，不堆名字。
      </p>
    </div>
  </section>

  <!-- 一手信息源 -->
  <section class="px-5 sm:px-8 lg:px-[120px] pb-[70px] bg-paper">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <h2 class="text-[28px] font-bold font-display text-ink">三个每天该去的地方</h2>
        <p class="text-[15px] text-ink-3">都是一手信息源，加起来每天不到 10 分钟。</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {sources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-rule rounded-[12px] ai-card p-[28px] flex flex-col gap-4 hover:border-accent transition"
          >
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-[20px] font-bold font-display text-ink">{s.name}</h3>
              <span class="mono-badge !text-[11px] !py-[2px] !px-[8px] text-ai-1 bg-accent-tint shrink-0">{s.cadence}</span>
            </div>
            <p class="text-[13px] font-medium text-accent">{s.tag}</p>
            <p class="text-[14px] leading-[24px] text-ink-2">{s.what}</p>
            <div class="tool-unfit flex flex-col gap-1.5 mt-auto">
              <p class="text-[12px] font-medium tracking-[1.2px]">怎么看</p>
              <p class="text-[13px] leading-[21px]">{s.how}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 今日 Top 10 快照：三个源的最新排名（静态站快照，每周刷新） -->
  <section class="px-5 sm:px-8 lg:px-[120px] pb-[70px] bg-paper">
    <div class="flex flex-col gap-[44px]">
      <div class="flex flex-col gap-2 max-w-[860px]">
        <div class="flex items-center gap-3 flex-wrap">
          <h2 class="text-[28px] font-bold font-display text-ink">今日 Top 10 实况</h2>
          <span class="mono-badge !text-[11px] !py-[2px] !px-[8px] text-ai-1 bg-accent-tint">数据截至 2026-09-15</span>
        </div>
        <p class="text-[15px] text-ink-3">
          三个源的最新排名快照，英文已翻译成中文，点击直达原文。三种「点击量」口径各看各的：
          GitHub 看<b class="text-ink">今日新增 Star</b>（增速），Product Hunt 看<b class="text-ink">当日赞数</b>，AI Base 看<b class="text-ink">浏览量</b>。
          静态站做不了实时，这里每周随「工具精选」一起人工刷新。
        </p>
      </div>

      <!-- GitHub Trending Top 10 -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3 flex-wrap">
          <h3 class="text-[21px] font-bold font-display text-ink">GitHub Trending</h3>
          <span class="text-[13px] text-ink-3">按今日新增 Star 排序</span>
          <a href="https://github.com/trending" target="_blank" rel="noopener noreferrer" class="text-[13px] font-medium text-accent hover:underline">看实时榜 ↗</a>
        </div>
        <ol class="flex flex-col gap-2">
          {ghTop.map((r, i) => (
            <li class="bg-white border border-rule rounded-[10px] px-4 py-3 flex items-start gap-3">
              <span class="mono-badge !text-[11px] !py-[2px] !px-[7px] text-ink-3 bg-paper-2 shrink-0 mt-[2px]">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex flex-col gap-0.5 min-w-0">
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-[15px] font-semibold font-display text-ink hover:text-accent transition truncate">{r.name}</a>
                <p class="text-[13px] leading-[21px] text-ink-2">{r.desc}<span class="text-ink-3 ml-2">{r.lang}</span></p>
              </div>
              <span class="ml-auto shrink-0 text-[13px] font-semibold text-accent whitespace-nowrap">{r.metric} 星/今日</span>
            </li>
          ))}
        </ol>
      </div>

      <!-- Product Hunt Top 10 -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3 flex-wrap">
          <h3 class="text-[21px] font-bold font-display text-ink">Product Hunt</h3>
          <span class="text-[13px] text-ink-3">当日产品榜（Top 5 已带赞数，其余为当日上榜顺序）</span>
          <a href="https://www.producthunt.com/" target="_blank" rel="noopener noreferrer" class="text-[13px] font-medium text-accent hover:underline">看实时榜 ↗</a>
        </div>
        <ol class="flex flex-col gap-2">
          {phTop.map((r, i) => (
            <li class="bg-white border border-rule rounded-[10px] px-4 py-3 flex items-start gap-3">
              <span class="mono-badge !text-[11px] !py-[2px] !px-[7px] text-ink-3 bg-paper-2 shrink-0 mt-[2px]">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex flex-col gap-0.5 min-w-0">
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-[15px] font-semibold font-display text-ink hover:text-accent transition">{r.name}</a>
                <p class="text-[13px] leading-[21px] text-ink-2">{r.desc}</p>
              </div>
              <span class="ml-auto shrink-0 text-[13px] font-semibold text-accent whitespace-nowrap">{r.metric}</span>
            </li>
          ))}
        </ol>
      </div>

      <!-- AI Base Top 10 -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3 flex-wrap">
          <h3 class="text-[21px] font-bold font-display text-ink">AI Base 新闻</h3>
          <span class="text-[13px] text-ink-3">按浏览量排序（K = 千次）</span>
          <a href="https://news.aibase.com/" target="_blank" rel="noopener noreferrer" class="text-[13px] font-medium text-accent hover:underline">看实时榜 ↗</a>
        </div>
        <ol class="flex flex-col gap-2">
          {aibaseTop.map((r, i) => (
            <li class="bg-white border border-rule rounded-[10px] px-4 py-3 flex items-start gap-3">
              <span class="mono-badge !text-[11px] !py-[2px] !px-[7px] text-ink-3 bg-paper-2 shrink-0 mt-[2px]">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex flex-col gap-0.5 min-w-0">
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-[15px] leading-[23px] font-semibold font-display text-ink hover:text-accent transition">{r.name}</a>
                <p class="text-[13px] leading-[21px] text-ink-2">{r.desc}</p>
              </div>
              <span class="ml-auto shrink-0 text-[13px] font-semibold text-accent whitespace-nowrap">{r.metric}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 博主清单 -->
  <section class="px-5 sm:px-8 lg:px-[120px] pb-[100px] bg-paper">
    <div class="flex flex-col gap-[54px]">
      <div class="flex flex-col gap-2">
        <h2 class="text-[28px] font-bold font-display text-ink">X 上值得长期关注的 AI 博主</h2>
        <p class="text-[15px] text-ink-3">
          中文区学「怎么用」，英文区看「正在发生」。全部为长期稳定输出的真实账号（2026-09 核对），
          关注 5-6 个就够，别贪多——时间线只会更吵。
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <h3 class="text-[21px] font-bold font-display text-ink">中文区</h3>
          <span class="text-[13px] text-ink-3">共 {bloggersCN.length} 个 · 信息密度优先</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {bloggersCN.map((b) => (
            <div class="bg-white border border-rule rounded-[12px] ai-card p-[24px] flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-[18px] font-bold font-display text-ink">{b.name}</h4>
                  <span class="mono-badge !text-[11px] !py-[2px] !px-[8px] text-ai-1 bg-accent-tint">@{b.handle}</span>
                </div>
                <span class="text-[12px] font-medium text-accent">{b.role}</span>
              </div>
              <p class="text-[14px] leading-[24px] text-ink-2">{b.why}</p>
              <a
                href={`https://x.com/${b.handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[13px] font-medium text-accent hover:underline self-start"
              >去 X 关注 @{b.handle} ↗</a>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <h3 class="text-[21px] font-bold font-display text-ink">英文区</h3>
          <span class="text-[13px] text-ink-3">共 {bloggersEN.length} 个 · 一手信息优先</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {bloggersEN.map((b) => (
            <div class="bg-white border border-rule rounded-[12px] ai-card p-[24px] flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-[18px] font-bold font-display text-ink">{b.name}</h4>
                  <span class="mono-badge !text-[11px] !py-[2px] !px-[8px] text-ai-1 bg-accent-tint">@{b.handle}</span>
                </div>
                <span class="text-[12px] font-medium text-accent">{b.role}</span>
              </div>
              <p class="text-[14px] leading-[24px] text-ink-2">{b.why}</p>
              <a
                href={`https://x.com/${b.handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[13px] font-medium text-accent hover:underline self-start"
              >去 X 关注 @{b.handle} ↗</a>
            </div>
          ))}
        </div>
      </div>

      <!-- 自己动手：把选博主 / 选工具的提示词交给读者 -->
      <div class="bg-paper-2 border border-rule rounded-[12px] p-7 flex flex-col gap-3">
        <p class="mono-badge text-ai-1">自己动手</p>
        <h3 class="text-[20px] font-bold font-display text-ink">想自己筛一批？两条提示词拿去用</h3>
        <p class="text-[14px] leading-[25px] text-ink-2">
          清单会过时，方法不会。让 AI 按你的关注方向实时推荐：
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/prompts/x-ai-bloggers" class="text-[14px] font-medium text-accent hover:underline">
            提示词：推荐值得关注的 AI 博主 →
          </a>
          <a href="/prompts/ai-tool-hunter-weekly" class="text-[14px] font-medium text-accent hover:underline">
            提示词：盘点过去 7 天的 AI 工具 →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
