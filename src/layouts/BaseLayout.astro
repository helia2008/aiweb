---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Subscribe from '../components/Subscribe.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  /** 是否显示订阅区 */
  showSubscribe?: boolean;
  /** 当前路径（用于高亮 nav） */
  pathname?: string;
  /** OG 图相对路径 */
  ogImage?: string;
  /** 页面类型：article 会输出 Article schema */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  /** 面包屑（同时输出 BreadcrumbList schema） */
  breadcrumbs?: { name: string; url: string }[];
  /** FAQ（输出 FAQPage schema，用于抢 People Also Ask 富摘要） */
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description = '写给不想学编程、但想把重复劳动交出去的人。痛点处方、工具罗盘、痛点门诊——只在跑通后写出来。',
  showSubscribe = true,
  pathname = Astro.url.pathname,
  ogImage,
  type = 'website',
  publishedAt,
  updatedAt,
  tags,
  breadcrumbs,
  faqs,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBF9F4" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      tags={tags}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
    />

    <!--
      字体：2026-09-04 移除 Google Fonts。实测 fonts.googleapis.com 在国内不可达
      （HTTP 000，约 15 秒才超时），手机浏览器会卡在此请求上导致长时间白屏——
      这就是「手机打不开」的根因。现全部改用系统字体栈（iOS 苹方/Android 思源/
      Windows 雅黑），零外部请求、秒开。将来要换字体必须自托管 woff2 到 /public/fonts/。
    -->

    <link rel="alternate" type="application/rss+xml" title="桌面 Agent 实战手册" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      分析：2026-09-04 暂时移除。原代码在生产域名会加载 umami.example.com（占位地址，
      每次访问都产生一次失败请求）。有真实统计站点后，把下面这段取消注释并填 ID 即可
      （推荐 umami 自托管 / plausible，不用 GA 以保加载速度）：

      {Astro.url.hostname === 'aiwind.eu.cc' && (
        <script defer src="https://你的统计域名/script.js" data-website-id="你的站点ID" is:inline />
      )}
    -->
  </head>

  <body class="bg-paper text-ink">
    <Header pathname={pathname} />

    <main>
      <slot />
    </main>

    {showSubscribe && <Subscribe />}

    <Footer />
  </body>
</html>
