---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Subscribe from '../components/Subscribe.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  /** 是否显示订阅区 */
  showSubscribe?: boolean;
  /** 当前路径（用于高亮 nav） */
  pathname?: string;
  /** OG 图相对路径 */
  ogImage?: string;
  /** 页面类型：article 会输出 Article schema */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  /** 面包屑（同时输出 BreadcrumbList schema） */
  breadcrumbs?: { name: string; url: string }[];
  /** FAQ（输出 FAQPage schema，用于抢 People Also Ask 富摘要） */
  faqs?: { q: string; a: string }[];
  /** HowTo（输出 HowTo schema，用于抢步骤富摘要） */
  howTo?: { name: string; steps: string[] } | null;
  /** 设 true 则输出 noindex,follow（薄内容/重复页用） */
  noindex?: boolean;
}

const {
  title,
  description = '写给不想学编程、但想把重复劳动交出去的人。痛点处方、工具罗盘、痛点门诊——只在跑通后写出来。',
  showSubscribe = true,
  pathname = Astro.url.pathname,
  ogImage,
  type = 'website',
  publishedAt,
  updatedAt,
  tags,
  breadcrumbs,
  faqs,
  howTo,
  noindex,
} = Astro.props;

/**
 * 仪表盘插槽（2026-09-15 变现方案第 0 步）
 * 两个 token 都走构建环境变量——面板填了即生效，代码零改动、本地构建自动静默：
 * - PUBLIC_GSC_VERIFICATION：Search Console 验证码（验证 HTML/meta 方式给的 content 值）
 * - PUBLIC_CF_BEACON_TOKEN：Cloudflare Web Analytics 的 JS beacon token
 * 在 Cloudflare Pages「设置 → 环境变量」里填入后重新部署即可。
 */
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const isProd = Astro.url.hostname === 'aiwind.eu.cc';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- 自适应主题色（浏览器地址栏/状态栏） -->
    <meta name="theme-color" content="#FBF9F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E11" media="(prefers-color-scheme: dark)" />

    <!-- 防 FOUC：绘制前确定主题（localStorage 优先，否则跟随系统） -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      tags={tags}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      howTo={howTo}
      noindex={noindex}
    />

    <!-- Search Console 验证（面板配 PUBLIC_GSC_VERIFICATION 环境变量后自动输出） -->
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!--
      字体：2026-09-04 移除 Google Fonts。实测 fonts.googleapis.com 在国内不可达
      （HTTP 000，约 15 秒才超时），手机浏览器会卡在此请求上导致长时间白屏——
      这就是「手机打不开」的根因。现全部改用系统字体栈（iOS 苹方/Android 思源/
      Windows 雅黑），零外部请求、秒开。将来要换字体必须自托管 woff2 到 /public/fonts/。
    -->

    <link rel="alternate" type="application/rss+xml" title="桌面 Agent 实战手册" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Cloudflare Web Analytics（免费/无 Cookie；面板配 PUBLIC_CF_BEACON_TOKEN 后自动启用，仅生产域名加载） -->
    {cfBeaconToken && isProd && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        is:inline
      />
    )}

    <!--
      分析：2026-09-04 移除 umami 占位（每次访问产生失败请求）。当前统计走上方
      Cloudflare Web Analytics 环境变量插槽；若将来换 umami/Plausible 自托管，
      参照同一模式加环境变量开关，不要再留占位地址。
    -->
  </head>

  <body class="bg-paper text-ink">
    <a href="#main" class="skip-link">跳到主内容</a>
    <div id="reading-progress" aria-hidden="true"></div>
    <Header pathname={pathname} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {showSubscribe && <Subscribe />}

    <Footer />
  </body>

  <!-- 阅读进度条 + 指令复制按钮（轻量、无依赖、纯 vanilla） -->
  <script is:inline>
    (function () {
      // JS 可用标记（reveal 动画依赖，避免无 JS 时内容不可见）
      document.documentElement.classList.add('js');

      // 阅读进度条
      var bar = document.getElementById('reading-progress');
      if (bar) {
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }

      // 入场滚动显现：进入视口才淡入上移
      var revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length && 'IntersectionObserver' in window) {
        var ro = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(function (el) { ro.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      }

      // 指令代码块：加复制按钮 + 语言小标
      var langLabel = { plaintext: '指令', bash: 'shell', text: '指令', md: 'markdown', yaml: 'yaml' };
      document.querySelectorAll('main pre').forEach(function (pre) {
        if (pre.parentElement && pre.parentElement.classList.contains('code-toolbar')) return;
        var lang = (pre.getAttribute('data-language') || 'plaintext').toLowerCase();
        var wrap = document.createElement('div');
        wrap.className = 'code-toolbar';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        var label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = langLabel[lang] || lang;
        wrap.appendChild(label);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制这段指令');
        btn.addEventListener('click', function () {
          var text = pre.innerText || '';
          function done() {
            btn.textContent = '已复制 ✓';
            btn.classList.add('copied');
            setTimeout(function () { btn.textContent = '复制'; btn.classList.remove('copied'); }, 1800);
          }
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done, function () { fallback(); });
          } else { fallback(); }
          function fallback() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = '复制失败'; }
            document.body.removeChild(ta);
          }
        });
        wrap.appendChild(btn);
      });
    })();
  </script>
</html>
