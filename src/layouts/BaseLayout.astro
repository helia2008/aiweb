---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Subscribe from '../components/Subscribe.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  /** 是否显示订阅区 */
  showSubscribe?: boolean;
  /** 当前路径（用于高亮 nav） */
  pathname?: string;
  /** OG 图相对路径 */
  ogImage?: string;
  /** 页面类型：article 会输出 Article schema */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  /** 面包屑（同时输出 BreadcrumbList schema） */
  breadcrumbs?: { name: string; url: string }[];
  /** FAQ（输出 FAQPage schema，用于抢 People Also Ask 富摘要） */
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description = '写给不想学编程、但想把重复劳动交出去的人。痛点处方、工具罗盘、痛点门诊——只在跑通后写出来。',
  showSubscribe = true,
  pathname = Astro.url.pathname,
  ogImage,
  type = 'website',
  publishedAt,
  updatedAt,
  tags,
  breadcrumbs,
  faqs,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBF9F4" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      tags={tags}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
    />

    <!--
      字体：2026-09-04 移除 Google Fonts。实测 fonts.googleapis.com 在国内不可达
      （HTTP 000，约 15 秒才超时），手机浏览器会卡在此请求上导致长时间白屏——
      这就是「手机打不开」的根因。现全部改用系统字体栈（iOS 苹方/Android 思源/
      Windows 雅黑），零外部请求、秒开。将来要换字体必须自托管 woff2 到 /public/fonts/。
    -->

    <link rel="alternate" type="application/rss+xml" title="桌面 Agent 实战手册" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      分析：2026-09-04 暂时移除。原代码在生产域名会加载 umami.example.com（占位地址，
      每次访问都产生一次失败请求）。有真实统计站点后，把下面这段取消注释并填 ID 即可
      （推荐 umami 自托管 / plausible，不用 GA 以保加载速度）：

      {Astro.url.hostname === 'aiwind.eu.cc' && (
        <script defer src="https://你的统计域名/script.js" data-website-id="你的站点ID" is:inline />
      )}
    -->
  </head>

  <body class="bg-paper text-ink">
    <div id="reading-progress" aria-hidden="true"></div>
    <Header pathname={pathname} />

    <main>
      <slot />
    </main>

    {showSubscribe && <Subscribe />}

    <Footer />
  </body>

  <!-- 阅读进度条 + 指令复制按钮（轻量、无依赖、纯 vanilla） -->
  <script is:inline>
    (function () {
      // JS 可用标记（reveal 动画依赖，避免无 JS 时内容不可见）
      document.documentElement.classList.add('js');

      // 阅读进度条
      var bar = document.getElementById('reading-progress');
      if (bar) {
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }

      // 入场滚动显现：进入视口才淡入上移
      var revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length && 'IntersectionObserver' in window) {
        var ro = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(function (el) { ro.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      }

      // 指令代码块：加复制按钮 + 语言小标
      var langLabel = { plaintext: '指令', bash: 'shell', text: '指令', md: 'markdown', yaml: 'yaml' };
      document.querySelectorAll('main pre').forEach(function (pre) {
        if (pre.parentElement && pre.parentElement.classList.contains('code-toolbar')) return;
        var lang = (pre.getAttribute('data-language') || 'plaintext').toLowerCase();
        var wrap = document.createElement('div');
        wrap.className = 'code-toolbar';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        var label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = langLabel[lang] || lang;
        wrap.appendChild(label);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制这段指令');
        btn.addEventListener('click', function () {
          var text = pre.innerText || '';
          function done() {
            btn.textContent = '已复制 ✓';
            btn.classList.add('copied');
            setTimeout(function () { btn.textContent = '复制'; btn.classList.remove('copied'); }, 1800);
          }
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done, function () { fallback(); });
          } else { fallback(); }
          function fallback() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = '复制失败'; }
            document.body.removeChild(ta);
          }
        });
        wrap.appendChild(btn);
      });
    })();
  </script>
</html>
