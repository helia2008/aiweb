---
export interface Props {
  pathname?: string;
}
const { pathname = '/' } = Astro.props;

const navItems = [
  { label: '首页', href: '/' },
  { label: 'Start Here', href: '/start-here' },
  { label: '痛点处方', href: '/prescriptions' },
  { label: '工具罗盘', href: '/tools' },
  { label: '关于', href: '/about' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-rule/70 bg-paper/80 backdrop-blur-md transition-colors"
>
  <div class="px-5 sm:px-8 lg:px-[120px] h-[68px] lg:h-[76px] flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-[10px] shrink-0">
      <span
        class="block w-[26px] h-[26px] rounded-[7px] shrink-0"
        style="background: linear-gradient(135deg, #4F46E5, #7C3AED);"
        aria-hidden="true"
      ></span>
      <span class="text-[16px] lg:text-[19px] font-bold font-display text-ink whitespace-nowrap">
        桌面 Agent 实战手册
      </span>
    </a>

    <!-- 桌面导航 -->
    <nav class="hidden lg:flex items-center gap-[30px]" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-[15px] font-medium transition relative py-1',
              isActive(item.href)
                ? 'text-transparent bg-clip-text bg-gradient-to-r from-ai-1 to-ai-2'
                : 'text-ink-2 hover:text-ink',
            ]}
          >{item.label}</a>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-[18px]">
      <button
        type="button"
        class="theme-toggle w-[42px] h-[42px] inline-flex items-center justify-center rounded-[8px] border border-rule text-ink-2 hover:text-ink hover:border-accent transition"
        aria-label="切换深色 / 浅色模式"
        aria-pressed="false"
      >
        <svg class="i-moon w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="i-sun w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a href="/rss.xml" class="text-[15px] font-medium text-ink-3 hover:text-ink transition">RSS</a>
      <a
        href="/#subscribe"
        class="h-[42px] px-[22px] inline-flex items-center btn-ai text-[14px]"
      >订阅更新</a>
    </div>

    <!-- 移动端汉堡按钮 -->
    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden flex flex-col justify-center items-center w-[42px] h-[42px] rounded-[8px] border border-rule"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-[18px] h-[1.5px] bg-ink mb-[5px] transition-transform"></span>
      <span class="block w-[18px] h-[1.5px] bg-ink mb-[5px]"></span>
      <span class="block w-[18px] h-[1.5px] bg-ink transition-transform"></span>
    </button>
  </div>

  <!-- 移动端菜单 -->
  <nav
    id="mobile-menu"
    class="lg:hidden hidden flex-col gap-1 px-5 pb-4 pt-2 border-t border-rule bg-paper/95 backdrop-blur-md"
    aria-label="移动端导航"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block py-3 text-[16px] font-medium border-b border-rule/60 last:border-0',
            isActive(item.href) ? 'text-ai-1' : 'text-ink-2',
          ]}
        >{item.label}</a>
      ))
    }
    <div class="flex gap-3 mt-3">
      <a
        href="/#subscribe"
        class="flex-1 h-[44px] inline-flex items-center justify-center btn-ai text-[15px]"
      >订阅更新</a>
      <a
        href="/rss.xml"
        class="h-[44px] px-5 inline-flex items-center justify-center border border-rule rounded-[10px] text-[15px] font-medium text-ink-2"
      >RSS</a>
      <button
        type="button"
        class="theme-toggle h-[44px] w-[44px] inline-flex items-center justify-center border border-rule rounded-[10px] text-ink-2"
        aria-label="切换深色 / 浅色模式"
        aria-pressed="false"
      >
        <svg class="i-moon w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="i-sun w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      var bars = btn.querySelectorAll('span');
      if (open) {
        bars[0].style.transform = 'translateY(6.5px) rotate(45deg)';
        bars[1].style.opacity = '0';
        bars[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
      } else {
        bars[0].style.transform = '';
        bars[1].style.opacity = '1';
        bars[2].style.transform = '';
      }
    });
    // 点击菜单项后自动收起
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    // 深色 / 浅色切换（桌面 + 移动按钮共用 .theme-toggle）
    var themeBtns = document.querySelectorAll('.theme-toggle');
    if (themeBtns.length) {
      function syncTheme() {
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        themeBtns.forEach(function (b) { b.setAttribute('aria-pressed', dark ? 'true' : 'false'); });
      }
      syncTheme();
      themeBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          var cur = document.documentElement.getAttribute('data-theme');
          var next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          syncTheme();
        });
      });
    }
  })();
</script>
